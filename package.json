{
  "name": "docs-cn",
  "type": "module",
  "version": "1.6.1",
  "private": true,
  "packageManager": "pnpm@8.10.3",
  "scripts": {
    "dev": "vitepress --port 3333 --open",
    "build": "nr prefetch && vitepress build",
    "build-no-prefetch": "vitepress build",
    "serve": "vitepress serve",
    "preview-https": "pnpm run build && serve .vitepress/dist",
    "preview-https-no-prefetch": "pnpm run build-no-prefetch && serve .vitepress/dist",
    "prefetch": "tsx .vitepress/scripts/fetch-avatars.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate-pwa-icons": "pwa-assets-generator",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@vueuse/core": "^10.6.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.1.28",
    "@iconify-json/logos": "^1.1.42",
    "@shikijs/vitepress-twoslash": "^1.10.3",
    "@unocss/reset": "^0.57.4",
    "@vite-pwa/assets-generator": "^0.0.11",
    "@vite-pwa/vitepress": "^0.2.3",
    "@vitejs/plugin-vue": "latest",
    "fast-glob": "^3.3.2",
    "https-localhost": "^4.7.1",
    "unocss": "^0.57.4",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^5.2.8",
    "vite-plugin-pwa": "^0.16.7",
    "vitepress": "^1.1.0",
    "workbox-window": "^7.0.0",
    "@antfu/eslint-config": "^5.4.1",
    "@antfu/ni": "^0.21.12",
    "@types/node": "^20.11.5",
    "@vitest/browser": "^1.6.1",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "vitest": "^1.6.1",
    "eslint": "^9.1.0",
    "lint-staged": "^16.2.7",
    "pathe": "^1.1.1",
    "pnpm": "8.10.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.6.1",
    "typescript": "^5.2.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
