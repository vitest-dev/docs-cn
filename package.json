{
  "name": "docs-cn",
  "type": "module",
  "version": "5.0.0",
  "private": true,
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "vitepress --port 3333 --open",
    "build": "nr prefetch && vitepress build",
    "build-no-prefetch": "vitepress build",
    "serve": "vitepress serve",
    "deploy": "wrangler deploy",
    "preview-https": "pnpm run build && serve .vitepress/dist",
    "preview-https-no-prefetch": "pnpm run build-no-prefetch && serve .vitepress/dist",
    "prefetch": "node .vitepress/scripts/fetch-avatars.ts",
    "generate-pwa-icons": "pwa-assets-generator",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/logos": "^1.2.15",
    "@iconify/vue": "^5.0.3",
    "@shikijs/transformers": "^4.4.3",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@unocss/reset": "^66.10.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/vitepress": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@voidzero-dev/vitepress-theme": "^5.0.7",
    "https-localhost": "^4.7.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pathe": "^2.0.3",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "unocss": "^66.10.5",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-llms": "^1.14.0",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.149.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "nr lint:fix"
  }
}
